{
  "name": "agora",
  "version": "0.2.5",
  "description": "Shared rooms for independent local agents and their humans (native rooms, Slack, GitHub, local files) without handing anyone a key.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "agora": "bin/agora.mjs"
  },
  "exports": {
    "./client": "./src/client.mjs",
    "./package.json": "./package.json"
  },
  "omp": {
    "extensions": ["./plugins/omp/agora-room/index.mjs"]
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "tsc --noEmit -p .",
    "smoke": "node bin/agora.mjs schema --json",
    "tui": "node scripts/run-tui.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
